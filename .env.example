# ══════════════════════════════════════════════════════════════════
# La Fusée v2 — configuration par variables d'environnement
# Copie ce fichier en `.env` et remplis au minimum les 3 REQUIS.
# Sans aucune autre clé, 100 % du périmètre déterministe fonctionne
# (intake, scoring, Oracle sections 1–21, PDF, paiement manuel, guilde…).
# ══════════════════════════════════════════════════════════════════

# ── REQUIS ────────────────────────────────────────────────────────
# PostgreSQL ≥ 16
DATABASE_URL="postgresql://lafusee:lafusee@localhost:5432/lafusee"
# Secret de session (générer : openssl rand -base64 32)
NEXTAUTH_SECRET=""
# URL publique de l'app (sans slash final)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Accès & god-mode ──────────────────────────────────────────────
# Emails élevés ADMIN + bypass des gates payants (séparés par des virgules).
# L'élévation n'est appliquée QUE si le compte a un email vérifié (seed / OAuth) —
# une inscription credentials sur un de ces emails n'obtient jamais ADMIN seule.
# Défaut si vide : xtincell@gmail.com,alexandre@upgraders.com,x-tincell@hotmail.fr,nefer@upgraders.io
# GOD_MODE_EMAILS=""
# Mot de passe du compte admin seedé — REQUIS en production (sinon généré + imprimé une fois).
# SEED_ADMIN_PASSWORD=""
# Google OAuth (le bouton n'apparaît que si les 2 sont présents)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Paiements (secrets système — les clés opérateur vivent dans le vault Console) ──
# Stripe (mode test en dev)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Numéro WhatsApp pour le paiement manuel (format international sans +, ex : 221771234567)
# MANUAL_PAYMENT_WHATSAPP_NUMBER=""

# ── LLM (optionnel — l'app est 100 % fonctionnelle sans) ──────────
# Provider principal : anthropic | openai | ollama | openrouter
# LLM_PRIMARY_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# Base OpenAI-compatible (défaut https://api.openai.com/v1) — pointe tout endpoint
# compatible : Ollama Cloud (https://ollama.com/v1), Together, Groq, vLLM local…
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OLLAMA_BASE_URL="http://localhost:11434"
# OPENROUTER_API_KEY=""
# Modèle par défaut du provider principal (ex : claude-sonnet-5)
# LLM_MODEL=""

# ── Crons HTTP (§7 : déclenchés par un scheduler externe) ─────────
# Requis en production pour /api/cron/* (fail-closed)
# CRON_SECRET=""

# ── Vault credentials opérateur ───────────────────────────────────
# Clé de chiffrement AES-256-GCM (défaut : dérivée de NEXTAUTH_SECRET)
# VAULT_SECRET=""

# ── Dev / CI uniquement ───────────────────────────────────────────
# Provider de paiement de test (mock). Verrouillé hors production réelle :
# exige NODE_ENV ≠ production OU une base URL localhost.
# PAYMENT_MOCK_ENABLED="true"
